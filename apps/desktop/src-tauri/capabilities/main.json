{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Minimum permissions for the bundled main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://replace-me.supabase.co/functions/v1/auth-broker/v1/desktop/authorize*"
        }
      ]
    }
  ]
}
