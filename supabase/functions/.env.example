# Server-only Supabase Edge Function configuration. Replace through `supabase secrets set`.
AUTH_BROKER_PUBLIC_URL=https://replace-me.supabase.co/functions/v1/auth-broker
AUTH_BROKER_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost
AUTH_BROKER_REDIRECT_ALLOWLIST=subtrack://auth/callback
AUTH_BROKER_HASH_KEY=replace-with-random-32-byte-minimum-hmac-key
AUTH_BROKER_CLEANUP_SECRET=replace-with-random-32-byte-minimum-cleanup-key
CLERK_FRONTEND_API_URL=https://replace-me.clerk.accounts.dev
CLERK_OAUTH_CLIENT_ID=replace-with-private-oauth-client-id
CLERK_OAUTH_CLIENT_SECRET=replace-with-private-oauth-client-secret
CLERK_SECRET_KEY=replace-with-clerk-backend-secret-key
SUPABASE_URL=https://replace-me.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
